import cv2
import os
import numpy as np
from ultralytics import YOLO


# CONFIGURACIÓN GENERAL
VIDEO_ROOT = "dataset/videos"        # Carpeta con videos por clase
OUT_DIR = "dataset/temporal"         # Carpeta de salida del dataset
WINDOW = 30                          # Frames por ventana temporal
STRIDE = 15                          # Desplazamiento entre ventanas (mínimo 50% de overlap)
 
# Mapeo carpeta vídeos -> etiqueta numérica
CLASSES = {
    "0_Cerrar": 0,
    "1_Parpadear": 1,
    "2_Izquierda": 2,
    "3_Derecha": 3,
    "4_Arriba": 4,
    "5_Abajo": 5,
    "6_Guiño": 6,
    "7_Giro": 7
}

os.makedirs(OUT_DIR, exist_ok=True)

# CARGA DEL MODELO YOLO
model = YOLO("models/yolo/eye_detector/weights/best.pt")


# NORMALIZACIÓN DEL IRIS RESPECTO AL OJO
def normalize(cx_iris, cy_iris, eye_box):
    x1, y1, x2, y2 = eye_box
    cx_eye = (x1 + x2) / 2
    cy_eye = (y1 + y2) / 2
    w_eye = x2 - x1
    h_eye = y2 - y1

    if w_eye == 0 or h_eye == 0:
        return None

    return [
        (cx_iris - cx_eye) / w_eye,
        (cy_iris - cy_eye) / h_eye
    ]

# CREACIÓN DEL DATASET
X, y = [], []

for folder, label in CLASSES.items():
    folder_path = os.path.join(VIDEO_ROOT, folder)

    for video in os.listdir(folder_path):
        cap = cv2.VideoCapture(os.path.join(folder_path, video))
        coords = []

        while True:
            ret, frame = cap.read()
            if not ret:
                break

            results = model(frame, verbose=False)[0]

            eyes = []
            irises = []

            # RECOLECTAR DETECCIONES CON CONFIANZA
            for b in results.boxes:
                cls_id = int(b.cls[0])
                cls_name = model.names[cls_id].lower()
                conf = float(b.conf[0])
                x1, y1, x2, y2 = b.xyxy[0].cpu().numpy()

                if cls_name == "ojos":
                    eyes.append((conf, (x1, y1, x2, y2)))

                elif cls_name == "iris":
                    irises.append((conf, ((x1 + x2) / 2, (y1 + y2) / 2)))

            # QUEDARSE CON LOS 2 MÁS CONFIABLES
            eyes = sorted(eyes, key=lambda x: x[0], reverse=True)[:2]
            irises = sorted(irises, key=lambda x: x[0], reverse=True)[:2]

            if len(eyes) < 2 or len(irises) < 2:
                continue

            eyes = [e[1] for e in eyes]
            irises = [i[1] for i in irises]


            # ORDENAR OJOS IZQUIERDO Y DERECHO
            eyes = sorted(eyes, key=lambda b: (b[0] + b[2]) / 2)
            left_eye, right_eye = eyes

            # ASIGNAR IRIS AL OJO MÁS CERCANO
            def closest_iris(eye, irises):
                ex = (eye[0] + eye[2]) / 2
                ey = (eye[1] + eye[3]) / 2
                return min(irises, key=lambda i: (i[0] - ex)**2 + (i[1] - ey)**2)

            left_iris = closest_iris(left_eye, irises)
            right_iris = closest_iris(right_eye, irises)

            coord_L = normalize(left_iris[0], left_iris[1], left_eye)
            coord_R = normalize(right_iris[0], right_iris[1], right_eye)

            if coord_L and coord_R:
                # [xL, yL, xR, yR]
                coords.append(coord_L + coord_R)

        cap.release()

        # VENTANAS TEMPORALES
        for i in range(0, len(coords) - WINDOW, STRIDE):
            X.append(coords[i:i + WINDOW])
            y.append(label)


# GUARDADO FINAL
X = np.array(X)
y = np.array(y)

np.save(f"{OUT_DIR}/X.npy", X)
np.save(f"{OUT_DIR}/y.npy", y)

print("✔ Dataset temporal creado correctamente")
print("X:", X.shape)
print("y:", y.shape)
