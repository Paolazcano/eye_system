import cv2
import os

# Ruta a la carpeta principal donde están los sujetos
base_dir = "Videos"        # Ruta de los vídeos
output_dir = "Frames"      # Carpeta donde se guardarán los frames
os.makedirs(output_dir, exist_ok=True)

# Configuración de muestreo
FRAME_INTERVAL = 2  # Extraer 1 de cada 2 frames
TARGET_FPS = 15     # 30 fps / 2 = 15 fps

print(f"EXTRACCIÓN A {TARGET_FPS} FPS (1 de cada {FRAME_INTERVAL} frames) - ANÁLISIS DE MOVIMIENTOS OCULARES")

# Recorre cada carpeta de sujeto 
for subject_folder in os.listdir(base_dir):
    subject_path = os.path.join(base_dir, subject_folder)

    # Solo procesar si es una carpeta
    if not os.path.isdir(subject_path):
        continue

    print(f"Procesando sujeto: {subject_folder}")

    # Crear carpeta de salida para este sujeto
    subject_output = os.path.join(output_dir, subject_folder)
    os.makedirs(subject_output, exist_ok=True)

    # Recorre los videos dentro del sujeto
    for video_file in os.listdir(subject_path):
        if not video_file.lower().endswith((".mp4", ".avi", ".mov", ".mkv")):
            continue  # saltar archivos que no sean video

        video_path = os.path.join(subject_path, video_file)
        video_name = os.path.splitext(video_file)[0]

        # Crear carpeta para los frames de este video
        video_output = os.path.join(subject_output, video_name)
        os.makedirs(video_output, exist_ok=True)

        print(f"  Extrayendo frames de: {video_file}")

        cap = cv2.VideoCapture(video_path)
        
        # Obtener información del video
        video_fps = cap.get(cv2.CAP_PROP_FPS)
        total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
        
        print(f"FPS del video: {video_fps}")
        print(f"Frames totales: {total_frames}")
        print(f"Objetivo: {TARGET_FPS} fps (1 de cada {FRAME_INTERVAL} frames)")

        frame_num = 0
        saved_frames = 0

        while True:
            ret, frame = cap.read()
            if not ret:
                break

            # Guardar 1 de cada 2 frames
            if frame_num % FRAME_INTERVAL == 0:
                frame_filename = f"frame_{saved_frames:05d}.jpg"
                frame_path = os.path.join(video_output, frame_filename)
                cv2.imwrite(frame_path, frame)
                saved_frames += 1

            # Mostrar progreso cada 100 frames
            if frame_num % 100 == 0:
                print(f"      Procesado frame {frame_num}/{total_frames}")

            frame_num += 1

        cap.release()
        
        # Calcular estadísticas
        video_duration = frame_num / video_fps if video_fps > 0 else 0
        effective_fps = saved_frames / video_duration if video_duration > 0 else 0
        
        print(f"{saved_frames} frames guardados en {video_output}")
        print(f"Duración del video: {video_duration:.2f} segundos")
        print(f"FPS efectivo: {effective_fps:.1f} fps")
        print(f"Reducción: {((total_frames - saved_frames) / total_frames * 100):.1f}% menos frames")

print("Extracción COMPLETA con muestreo 1:2.")